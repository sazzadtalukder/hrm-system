NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_BODY_LIMIT=1mb
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=hrm
DB_USER=hrm_app
DB_PASSWORD=change-me
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=hrm-api
JWT_AUDIENCE=hrm-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=hrm_refresh
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Required only when running the controlled organization bootstrap.
ORGANIZATION_COMPANY_CODE=
ORGANIZATION_COMPANY_NAME=
ORGANIZATION_COMPANY_COUNTRY=BD
ORGANIZATION_COMPANY_CURRENCY=BDT
ORGANIZATION_COMPANY_TIMEZONE=Asia/Dhaka
ORGANIZATION_COMPANY_LOCALE=en-BD
